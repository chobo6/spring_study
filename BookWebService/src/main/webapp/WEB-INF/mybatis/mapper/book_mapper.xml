<?xml version="1.0" encoding="UTF-8"?> 
<!DOCTYPE mapper PUBLIC
		   "-//mybatis.org//DTD Mapper 3.0//EN" 
		   "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
		   
<mapper namespace="book_mapper">

	<select id="findBookList" resultType="Book">
		SELECT *
		FROM T_BOOK
		ORDER BY
		id
	</select>
	
	<select id="findBookByBookId" resultType="Book" parameterType="int">
		SELECT *
		FROM T_BOOK
		WHERE ID = #{bookId}
	</select>
	
	<insert id="saveBook" parameterType="Book">
		INSERT INTO T_BOOK VALUES (
			SEQ_T_BOOK_PK.nextval,
			#{title},
			#{author},
			#{price}
		)
	</insert>
	
	<delete id="removeBook" parameterType="int">
		DELETE FROM T_BOOK
		WHERE ID = #{id}
	</delete>
	
	<update id="modifyBook" parameterType="Book">
		UPDATE T_BOOK
		SET 
			TITLE = #{title},
			AUTHOR =  #{author},
			PRICE =  #{price}
		WHERE ID = #{id}
	</update>
</mapper>